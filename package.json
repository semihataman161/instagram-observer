{
  "name": "instagram-observer",
  "version": "1.0.0",
  "scripts": {
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx}' --config ./.prettierrc.json",
    "copy-public": "mkdir -p dist && cp -r public/* dist/",
    "build": "vite build && npm run copy-public",
    "build:dev": "vite build --watch && npm run copy-public"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.0.0",
    "vite": "^6.3.2"
  }
}
