{
  "manifest_version": 3,
  "name": "Instagram Observer",
  "version": "1.0",
  "description": "Track changes in Instagram profile pages",
  "icons": {
    "16": "./assets/16.png",
    "32": "./assets/32.png",
    "48": "./assets/48.png",
    "128": "./assets/128.png"
  },
  "action": {
    "default_title": "Instagram Observer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "./assets/16.png",
      "32": "./assets/32.png",
      "48": "./assets/48.png",
      "128": "./assets/128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["web.accessible.esource.js"],
      "matches": ["https://www.instagram.com/*"]
    }
  ],
  "permissions": ["storage", "notifications"],
  "host_permissions": ["https://www.instagram.com/*"]
}
